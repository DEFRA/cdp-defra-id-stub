# Copy to .env and adjust for local development ( .env is gitignored )

PORT=3200
APP_BASE_URL=http://localhost:3200
NODE_ENV=development

# OIDC defaults match cdp-defra-id-demo local setup
# OIDC_CLIENT_ID=63983fc2-cfff-45bb-8ec2-959e21062b9a
# OIDC_CLIENT_SECRET=test_value
# OIDC_BASE_PATH=/cdp-defra-id-stub
# OIDC_SHOW_LOGIN=true

# Registrations store — local DynamoDB via Floci (LocalStack replacement)
# Start Floci: docker compose up -d floci
# Create table manually: npm run local:dynamodb:create-table
REGISTRATIONS_STORE_ENGINE=dynamodb
REGISTRATIONS_STORE_TTL=259200000
AWS_DYNAMODB_REGISTRATIONS_TABLE_NAME=cdp-defra-id-stub-registrations
DYNAMODB_ENDPOINT=http://127.0.0.1:4566
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Only needed when using Docker Compose redis service (not required for npm run dev)
# REDIS_HOST=127.0.0.1
# USE_SINGLE_INSTANCE_CACHE=true
