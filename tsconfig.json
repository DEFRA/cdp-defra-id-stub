{
  "compilerOptions": {
    "allowJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "paths": {
      "#config/*": ["./src/config/*"],
      "#server/*": ["./src/server/*"],
      "#__fixtures__/*": ["./src/__fixtures__/*"]
    },
    "resolveJsonModule": true
  },
  "exclude": [".cache", ".public", ".server", "node_modules"],
  "include": ["**/*.cjs", "**/*.js"]
}
